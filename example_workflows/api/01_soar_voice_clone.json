{
  "1": {
    "class_type": "T8_DotsTTS_ModelLoader",
    "inputs": {
      "model_name": "dots.tts SOAR · Quality [soar]",
      "precision": "bfloat16",
      "optimize": false,
      "release_after_run": false,
      "verify_hashes": false,
      "custom_model_path": ""
    }
  },
  "2": {
    "class_type": "LoadAudio",
    "inputs": {"audio": "voice_reference.wav"}
  },
  "3": {
    "class_type": "T8_DotsTTS_VoicePrompt",
    "inputs": {
      "audio": ["2", 0],
      "transcript": "请把这里改成参考音频的逐字转写。",
      "language": "ZH"
    }
  },
  "4": {
    "class_type": "T8_DotsTTS_Sampling",
    "inputs": {
      "ode_method": "euler",
      "num_steps": 10,
      "guidance_scale": 1.2,
      "speaker_scale": 1.5,
      "normalize_text": false,
      "max_generate_length": 500
    }
  },
  "5": {
    "class_type": "T8_DotsTTS_Generate",
    "inputs": {
      "model": ["1", 0],
      "text": "欢迎使用 dots.tts，来自 T8star-Aix。",
      "language": "inherit",
      "seed": 20260823,
      "voice": ["3", 0],
      "sampling": ["4", 0]
    }
  },
  "6": {
    "class_type": "SaveAudio",
    "inputs": {
      "audio": ["5", 0],
      "filename_prefix": "dots_tts_T8/soar_clone"
    }
  }
}
